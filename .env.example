# Copy this file to .env and fill in your real keys
# Never commit the actual .env file

# Cheap/fast model provider (choose one)
GROQ_API_KEY=your_groq_key_here
# TOGETHER_API_KEY=your_together_key_here

# Expensive/smart model provider
OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Model identifiers
CHEAP_MODEL_NAME=llama-3.2-3b-preview
EXPENSIVE_MODEL_NAME=gpt-4o

# Routing config
DIFFICULTY_THRESHOLD=3
CONFIDENCE_THRESHOLD=0.6